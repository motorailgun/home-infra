# {{ ansible_managed }}
server {
	server_name	{{ mirror_domain }};
	root		{{ mirror_root }};

	location / {
		autoindex on;
		autoindex_exact_size off;
		try_files $uri $uri/ =404;
	}

	# scraped by prometheus-nginx-exporter
	location /stub_status {
		stub_status on;
		access_log off;
		allow 127.0.0.1;
		deny all;
	}

	listen [::]:80;
	listen 80;
	# LAN only (ufw); also scraped by prometheus-nginx-exporter
	listen 8080;
{% if mirror_tls_enabled %}

	listen [::]:443 ssl ipv6only=on;
	listen 443 ssl;

	ssl_certificate /etc/letsencrypt/live/{{ mirror_domain }}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{ mirror_domain }}/privkey.pem;
	include /etc/letsencrypt/options-ssl-nginx.conf;
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
{% endif %}
}
